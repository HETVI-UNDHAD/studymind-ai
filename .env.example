# StudyMind AI Configuration

# Environment mode
APP_ENV=development
ENVIRONMENT=development
PORT=8000

# Database path (optional; defaults to backend/data/storage/studymind_db.json)
STUDYMIND_DB_PATH=backend/data/storage/studymind_db.json

# Server-side Supabase Configuration. Keep the service role key private.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=course-materials

# AI Provider Configuration
# Options: groq, mock, openai, gemini, transformers
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_EXTRACT=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_CRITIC=qwen/qwen3.8-27b
EMBEDDING_PROVIDER=transformers
VISION_PROVIDER=groq
VISION_MODEL=
STT_PROVIDER=mock

# External API Keys (Optional when using mock provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Retrieval Confidence Settings
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
MAX_RETRIEVED_CHUNKS=5

# Ingestion Performance Tuning
INGEST_MAX_WORKERS=4
EMBED_BATCH_SIZE=64
DB_DEBOUNCE_SECONDS=2.0
LLM_MAX_CONCURRENCY=2
CHUNK_MIN_WORDS=35
CHUNK_MAX_WORDS=300
CHUNK_MIN_CHARS=120
CONCEPT_MERGE_HIGH_SIM=0.90
CONCEPT_MERGE_LOW_SIM=0.78
CHUNK_TAG_THRESHOLD=0.55

